<!--
  Ackermann navigate-to-pose tree. Differences from the Nav2 default:

  * PLAN ONCE per goal (GoalUpdatedController), not on a timer. The planner
    is Smac Hybrid-A* with Reeds-Shepp, whose paths may legitimately contain
    cusps; replanning on a timer re-anchored the path at the robot every
    cycle and put a fresh one-cell reverse under it each time - the
    "moves in steps" gait. With no obstacle layer a path never becomes
    invalid, so the only events that justify a new plan are a new goal, a
    follow failure (the recovery below replans from the current pose) and
    the outer recovery round.
  * Spin is removed: a servo-steered car cannot rotate in place, so a Spin
    recovery would command a motion the vehicle physically cannot perform
    and then fail the whole navigation on its timeout. BackUp survives,
    because straight reverse is a motion a car *can* make.
  * No SmoothPath: Smac smooths its own output, cusp-aware.
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <ControllerSelector selected_controller="{selected_controller}" default_controller="FollowPath" topic_name="controller_selector"/>
        <PlannerSelector selected_planner="{selected_planner}" default_planner="GridBased" topic_name="planner_selector"/>
        <GoalUpdatedController>
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="{selected_planner}" error_code_id="{compute_path_error_code}"/>
            <Sequence>
              <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
              <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
            </Sequence>
          </RecoveryNode>
        </GoalUpdatedController>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="{selected_controller}" error_code_id="{follow_path_error_code}"/>
          <Sequence>
            <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
            <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
            <ComputePathToPose name="ReplanFromHere" goal="{goal}" path="{path}" planner_id="{selected_planner}" error_code_id="{compute_path_error_code}"/>
          </Sequence>
        </RecoveryNode>
      </PipelineSequence>
      <Sequence>
        <Fallback>
          <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
          <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
        </Fallback>
        <ReactiveFallback name="RecoveryFallback">
          <GoalUpdated/>
          <RoundRobin name="RecoveryActions">
            <Sequence name="ClearingActions">
              <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
              <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
            </Sequence>
            <BackUp backup_dist="0.30" backup_speed="0.25" error_code_id="{backup_code_id}"/>
            <Wait wait_duration="3.0"/>
          </RoundRobin>
        </ReactiveFallback>
      </Sequence>
    </RecoveryNode>
  </BehaviorTree>
</root>
